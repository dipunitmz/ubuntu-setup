bind -P | grep -E 'history|__fzf'

mkdir -p ~/.blerc
echo 'bleopt keymap_vi_mode_show=' >> ~/.blerc

# Check what is inside the directory
ls -la ~/.blerc
# Remove it if empty
rmdir ~/.blerc 2>/dev/null
# Create the actual configuration file
echo 'bleopt keymap_vi_mode_show=' > ~/.blerc
source ~/.bashrc

# Preserve the mistakenly created directory, if it exists.
if [[ -d ~/.blerc ]]; then
    mv ~/.blerc ~/.blerc.directory-backup
fi
# Create the actual configuration file.
printf '%s\n' \
  'bleopt keymap_emacs_mode_string_multiline=' \
  > ~/.blerc

  ls -ld ~/.blerc

  mv ~/.blerc ~/.blerc.directory-backup

  printf '%s\n' 'bleopt keymap_emacs_mode_string_multiline=' > ~/.blerc
  bind -P | grep -E 'backward-kill-word|unix-word-rubout'

  cat >> ~/.blerc <<'EOF'

# Alt + Backspace: delete the previous word
ble-bind -f 'M-DEL' kill-backward-cword
ble-bind -f 'M-C-?' kill-backward-cword
EOF